# ============================================================================
# AI-POWERED CUSTOMER SUPPORT AGENT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production credentials.
# ============================================================================

# Flask Application
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-to-a-secure-random-secret-key-in-production-2026

# JWT Authentication
JWT_SECRET_KEY=super-secret-jwt-signing-key-minimum-32-characters-length-2026
JWT_ACCESS_TOKEN_EXPIRES=86400

# Google Gemini API (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase PostgreSQL & pgvector (Get from https://supabase.com/)
# Leave empty for zero-config local evaluation mode
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database Mode: "auto", "supabase", or "sqlite"
DB_MODE=auto

# Storage & Uploads
UPLOAD_FOLDER=uploads
